# 05_seatmap_and_manifest_test.meme — Test seatmap grid matching, manifest revenue math, and neighbor checks
use ../../models
use ../../grid_ops
use ../../flight_ops

test seatmap_grid_and_neighbor_checks:
    define grid: List<List<String>> as create_empty_grid(3, 3)

    # Empty grid: all cells are "."
    for r from 0 to 2:
        for c from 0 to 2:
            assert grid[r][c] == "."

    # Book 1A (0,0), 1B (0,1), 2A (1,0)
    set grid[0][0] to "Alice"
    set grid[0][1] to "Bob"
    set grid[1][0] to "Charlie"

    # Total occupied seats
    define occupied: Int as count_occupied_seats(grid, 3, 3)
    assert occupied == 3

    # Neighbor checks for 1A (0,0):
    # Right neighbor (0,1) is "Bob", Behind neighbor (1,0) is "Charlie" -> 2 neighbors
    define n_1a: Int as count_occupied_neighbors(grid, 0, 0, 3, 3)
    assert n_1a == 2

    # Neighbor checks for 1B (0,1):
    # Left neighbor (0,0) is "Alice", Right (0,2) is ".", Behind (1,1) is "." -> 1 neighbor
    define n_1b: Int as count_occupied_neighbors(grid, 0, 1, 3, 3)
    assert n_1b == 1

    # Neighbor checks for 3C (2,2):
    # Front (1,2) is ".", Left (2,1) is "." -> 0 neighbors
    define n_3c: Int as count_occupied_neighbors(grid, 2, 2, 3, 3)
    assert n_3c == 0

test manifest_revenue_math:
    # 25000 cents per seat = $250.00
    define price_cents: Int as 25000
    define booked_count: Int as 4
    define total_rev: Int as booked_count * price_cents
    assert total_rev == 100000

    define formatted_rev: String as format_cents(total_rev)
    assert formatted_rev == "1000.00"

    define formatted_price: String as format_cents(price_cents)
    assert formatted_price == "250.00"

    # Zero revenue
    define zero_rev: String as format_cents(0)
    assert zero_rev == "0.00"
