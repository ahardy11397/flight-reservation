# main.meme — Flight Reservation CLI entry point
use models
use grid_ops
use flight_ops

function print_usage() -> Void:
    print "Usage: flight <command> [arguments...]"
    print "Commands:"
    print "  flight add <flight-no> <rows> <seat-cols> <price-cents>"
    print "  flight book <flight-no> <passenger-name> [seat]"
    print "  flight cancel <flight-no> <seat>"
    print "  flight manifest <flight-no>"
    print "  flight seatmap <flight-no>"
    print "  flight waitlist <flight-no> <passenger-name>"
    print "  flight promote <flight-no>"

define argc: Int as argument count
if argc < 2:
    call print_usage()
    fail with "Error: Missing command"

define cmd: String as argument 1

if cmd == "add":
    if argc != 6:
        call print_usage()
        fail with "Error: 'add' requires <flight-no> <rows> <seat-cols> <price-cents>"
    define f_no: String as argument 2
    define f_path: String as flight_file_path(f_no)
    define existing_opt: Optional<FlightData> as load_flight_record(f_path)
    if existing_opt is not nothing:
        fail with "Error: Flight " + f_no + " already exists"
    define rows_str: String as argument 3
    define cols_str: String as argument 4
    define price_str: String as argument 5
    define rows: Int as integer value of rows_str or else -1
    define cols: Int as integer value of cols_str or else -1
    define price: Int as integer value of price_str or else -1
    if rows <= 0 or cols <= 0 or cols > 26 or price <= 0:
        fail with "Error: Invalid rows, seat-cols, or price-cents"
    define new_flight: FlightData as FlightData(flight_no=f_no, rows=rows, seat_cols=cols, price_cents=price, seats_data="", waitlist_data="")
    call save_flight_record(f_path, new_flight)
    print "Added flight " + f_no + " (" + text of rows + " rows, " + text of cols + " columns, " + text of price + " cents)"
    exit with code 0

if cmd == "book":
    if argc != 4 and argc != 5:
        call print_usage()
        fail with "Error: 'book' requires <flight-no> <passenger-name> [seat]"
    define f_no: String as argument 2
    define passenger: String as argument 3
    define f_path: String as flight_file_path(f_no)
    define opt_data: Optional<FlightData> as load_flight_record(f_path)
    if opt_data is nothing:
        fail with "Error: Flight " + f_no + " not found"
    define flight: FlightData as value of opt_data
    define grid: List<List<String>> as reconstruct_grid(flight)
    define chosen_seat: String as ""
    if argc == 5:
        define req_seat: String as upper (argument 4)
        if not (is_valid_seat_format(req_seat, flight.rows, flight.seat_cols)):
            fail with "Error: Invalid seat format: " + req_seat
        define r: Int as seat_to_row(req_seat)
        define c: Int as seat_to_col(req_seat)
        if grid[r][c] != ".":
            fail with "Error: Seat " + req_seat + " is already booked by " + grid[r][c]
        set chosen_seat to req_seat
        set grid[r][c] to passenger
    else:
        define best: String as find_best_seat(grid, flight.rows, flight.seat_cols)
        if length of string best == 0:
            fail with "Error: Flight " + f_no + " is full. Join waitlist via: flight waitlist " + f_no + " " + passenger
        define r: Int as seat_to_row(best)
        define c: Int as seat_to_col(best)
        set chosen_seat to best
        set grid[r][c] to passenger
    define new_seats_data: String as serialize_grid(grid, flight.rows, flight.seat_cols)
    define updated: FlightData as FlightData(flight_no=flight.flight_no, rows=flight.rows, seat_cols=flight.seat_cols, price_cents=flight.price_cents, seats_data=new_seats_data, waitlist_data=flight.waitlist_data)
    call save_flight_record(f_path, updated)
    print "Booked " + passenger + " on " + f_no + " seat " + chosen_seat
    exit with code 0

if cmd == "cancel":
    if argc != 4:
        call print_usage()
        fail with "Error: 'cancel' requires <flight-no> <seat>"
    define f_no: String as argument 2
    define seat: String as upper (argument 3)
    define f_path: String as flight_file_path(f_no)
    define opt_data: Optional<FlightData> as load_flight_record(f_path)
    if opt_data is nothing:
        fail with "Error: Flight " + f_no + " not found"
    define flight: FlightData as value of opt_data
    if not (is_valid_seat_format(seat, flight.rows, flight.seat_cols)):
        fail with "Error: Invalid seat format: " + seat
    define r: Int as seat_to_row(seat)
    define c: Int as seat_to_col(seat)
    define grid: List<List<String>> as reconstruct_grid(flight)
    if grid[r][c] == ".":
        fail with "Error: Seat " + seat + " is not booked"
    define prev_p: String as grid[r][c]
    set grid[r][c] to "."
    define new_seats_data: String as serialize_grid(grid, flight.rows, flight.seat_cols)
    define updated: FlightData as FlightData(flight_no=flight.flight_no, rows=flight.rows, seat_cols=flight.seat_cols, price_cents=flight.price_cents, seats_data=new_seats_data, waitlist_data=flight.waitlist_data)
    call save_flight_record(f_path, updated)
    print "Cancelled seat " + seat + " on " + f_no + " for " + prev_p
    exit with code 0

if cmd == "manifest":
    if argc != 3:
        call print_usage()
        fail with "Error: 'manifest' requires <flight-no>"
    define f_no: String as argument 2
    define f_path: String as flight_file_path(f_no)
    define opt_data: Optional<FlightData> as load_flight_record(f_path)
    if opt_data is nothing:
        fail with "Error: Flight " + f_no + " not found"
    define flight: FlightData as value of opt_data
    define grid: List<List<String>> as reconstruct_grid(flight)
    print "=== Manifest for Flight " + f_no + " ==="
    define booked_count: Int as 0
    for r from 0 to flight.rows - 1:
        for c from 0 to flight.seat_cols - 1:
            if grid[r][c] != ".":
                set booked_count to booked_count + 1
                define seat: String as row_col_to_seat(r, c)
                print seat + ": " + grid[r][c]
    define rev_cents: Int as booked_count * flight.price_cents
    define rev_dollars: String as format_cents(rev_cents)
    define price_dollars: String as format_cents(flight.price_cents)
    print "Total passengers: " + text of booked_count
    print "Price per seat: $" + price_dollars
    print "Total revenue: $" + rev_dollars
    exit with code 0

if cmd == "seatmap":
    if argc != 3:
        call print_usage()
        fail with "Error: 'seatmap' requires <flight-no>"
    define f_no: String as argument 2
    define f_path: String as flight_file_path(f_no)
    define opt_data: Optional<FlightData> as load_flight_record(f_path)
    if opt_data is nothing:
        fail with "Error: Flight " + f_no + " not found"
    define flight: FlightData as value of opt_data
    define grid: List<List<String>> as reconstruct_grid(flight)
    print "=== Seatmap for Flight " + f_no + " ==="
    define col_header: String as "    "
    for c from 0 to flight.seat_cols - 1:
        set col_header to col_header + col_to_letter(c) + " "
    print col_header
    for r from 0 to flight.rows - 1:
        define row_num: Int as r + 1
        define row_line: String as ""
        if row_num < 10:
            set row_line to "  " + text of row_num + " "
        else if row_num < 100:
            set row_line to " " + text of row_num + " "
        else:
            set row_line to text of row_num + " "
        for c from 0 to flight.seat_cols - 1:
            if grid[r][c] == ".":
                set row_line to row_line + ". "
            else:
                set row_line to row_line + "X "
        print row_line
    exit with code 0

if cmd == "waitlist":
    if argc != 4:
        call print_usage()
        fail with "Error: 'waitlist' requires <flight-no> <passenger-name>"
    define f_no: String as argument 2
    define passenger: String as argument 3
    define f_path: String as flight_file_path(f_no)
    define opt_data: Optional<FlightData> as load_flight_record(f_path)
    if opt_data is nothing:
        fail with "Error: Flight " + f_no + " not found"
    define flight: FlightData as value of opt_data
    define list waitlist as reconstruct_waitlist(flight)
    add passenger to waitlist
    define new_w_data: String as serialize_waitlist(waitlist)
    define updated: FlightData as FlightData(flight_no=flight.flight_no, rows=flight.rows, seat_cols=flight.seat_cols, price_cents=flight.price_cents, seats_data=flight.seats_data, waitlist_data=new_w_data)
    call save_flight_record(f_path, updated)
    print "Added " + passenger + " to waitlist for " + f_no + " (position " + text of (length of waitlist) + ")"
    exit with code 0

if cmd == "promote":
    if argc != 3:
        call print_usage()
        fail with "Error: 'promote' requires <flight-no>"
    define f_no: String as argument 2
    define f_path: String as flight_file_path(f_no)
    define opt_data: Optional<FlightData> as load_flight_record(f_path)
    if opt_data is nothing:
        fail with "Error: Flight " + f_no + " not found"
    define flight: FlightData as value of opt_data
    define list waitlist as reconstruct_waitlist(flight)
    if length of waitlist == 0:
        fail with "Error: Waitlist is empty for flight " + f_no
    define grid: List<List<String>> as reconstruct_grid(flight)
    define best: String as find_best_seat(grid, flight.rows, flight.seat_cols)
    if length of string best == 0:
        fail with "Error: Flight " + f_no + " is full; cannot promote from waitlist"
    define passenger: String as waitlist[0]
    remove item 0 from waitlist
    define r: Int as seat_to_row(best)
    define c: Int as seat_to_col(best)
    set grid[r][c] to passenger
    define new_seats: String as serialize_grid(grid, flight.rows, flight.seat_cols)
    define new_w: String as serialize_waitlist(waitlist)
    define updated: FlightData as FlightData(flight_no=flight.flight_no, rows=flight.rows, seat_cols=flight.seat_cols, price_cents=flight.price_cents, seats_data=new_seats, waitlist_data=new_w)
    call save_flight_record(f_path, updated)
    print "Promoted " + passenger + " from waitlist to seat " + best + " on " + f_no
    exit with code 0

call print_usage()
fail with "Error: Unknown command: " + cmd
